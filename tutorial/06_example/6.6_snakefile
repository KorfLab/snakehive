configfile: 'config/6.6_config.yaml'

rule all:
    input:
        expand('results/6.6_files/{col}_{num}_{eat}.txt',
            col = config['colors'],
            num = config['numbers'],
            eat = config['foods'])

rule orders:
    output:
        'results/6.6_files/{col}_{num}_{eat}.txt'
    shell:
        '''
        echo "starting {wildcards.col}_{wildcards.num}_{wildcards.eat}.txt"
        sleep 3
        echo "Can I get {wildcards.num} {wildcards.col} {wildcards.eat} to go please" > {output}
        echo "finished {wildcards.col}_{wildcards.num}_{wildcards.eat}.txt"
        sleep 2
        '''