configfile: 'config/5.5_config.yaml'

rule fam_count:
    output:
        'results/fam_count.tsv'
    params:
        pat1 = config['fam']['dad']['cake'],
        pat2 = config['fam']['dad']['ice_cream'],
        pat3 = config['fam']['dad']['pie'],
        mat1 = config['fam']['mom']['cake'],
        mat2 = config['fam']['mom']['ice_cream'],
        mat3 = config['fam']['mom']['pie']
    shell:
        '''
        printf "sweet_treat\tdad\tmom\n" > {output}
        printf "cake\t{params.pat1}\t{params.mat1}\n" >> {output}
        printf "ice_cream\t{params.pat2}\t{params.mat2}\n" >> {output}
        printf "pie\t{params.pat3}\t{params.mat3}" >> {output}
        '''