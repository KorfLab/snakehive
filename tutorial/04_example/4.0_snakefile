rule all:
    input:
        'results/in_and_out.txt'

rule in_and_out:
    input:
        'resources/1pct.fa.gz'
    output:
        'results/in_and_out.txt'
    shell:
        '''
        echo "This is the input: {input}" > {output}
        echo "This is the output: {output}" >> {output}
        '''